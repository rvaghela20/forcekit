{
  "name": "forcekit",
  "version": "2.0.0-alpha.1",
  "description": "AI Agent Framework for Salesforce — programmatic context, tools, plugins, and agent lifecycle management.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forcekit": "./dist/bin/forcekit.js"
  },
  "files": [
    "dist/",
    "agents/definitions/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/tests/**/*.test.js",
    "test:build": "npm run build && npm run test",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "ajv": "^8.17.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "salesforce",
    "ai-agent",
    "framework",
    "forcekit",
    "agentforce",
    "mcp",
    "apex",
    "lwc",
    "sfdx"
  ]
}
